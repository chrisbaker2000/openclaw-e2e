# Example: API-only testing (no Docker/SSH access)
# Useful for cloud-hosted gateways where you can't access the container.
# Only core HTTP, memory API, and latency tests will run.
OPENCLAW_GATEWAY_URL="https://your-gateway.example.com:18789"
OPENCLAW_MEMORY_SERVER_URL="https://agent-memory-server.your-project.run.app"
OPENCLAW_MEMORY_NAMESPACE="default"
